params {
    // tests/data/ holds the synthetic dataset built by
    // tests/data/generate_synthetic_reads.py -- four samples, one per outcome
    // (PASS / PASS / WARN mixed / FAIL too_few_reads), see that script.
    input    = 'tests/data/samplesheet.csv'
    min_len  = 200
    max_len  = 2000
    min_qual = 10

    // CI stays light: medaka's image is large and the synthetic reads carry no
    // basecaller metadata. This means the medaka path is NOT exercised by CI --
    // run it by hand (-profile test,docker --enable_medaka true).
    enable_medaka = false

    // 300 reads/sample, so the default 1500 never downsamples; exercise it
    downsample_reads = 200
}
