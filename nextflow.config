manifest {
    name            = 'single-amplicon-nf'
    description     = 'ONT single-amplicon (one barcode gene per sample) consensus pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.2.0'
}

params {
    // see main.nf for the help text. Everything a module or workflow script
    // reads directly is declared HERE, not in main.nf, so it is reliably set
    // before the included script runs (profiles like `test` can still override).
    // Params with no sensible default are null; the platform's schema form
    // submits an empty string for an untouched field, so the code treats ''
    // and null the same way (`if (params.x)`).
    input   = null   // samplesheet CSV: sample,fastq (fastq may be a glob; resolved from the launch dir)
    outdir  = "results"
    tracedir = "${params.outdir}/pipeline_info"
    help    = false

    // where each module's container image is pulled from; the google_batch
    // profile points both at the project's Artifact Registry mirror
    // (scripts/mirror_images.sh)
    container_registry = 'quay.io'
    dockerhub_registry = 'docker.io'

    // primer trimming (cutadapt); skipped unless BOTH are set
    fwd_primer = null
    rev_primer = null

    // chopper. A barcode gene has no sensible universal length window, so set
    // min_len / max_len for your amplicon. max_len = null means no upper cap.
    min_len  = 300
    max_len  = null
    min_qual = 10
    enable_read_stats = true

    // reads used for the consensus. 0 = use everything. Random, seeded, so a
    // rerun gives the same consensus. Samples left with fewer than min_reads
    // reads get no consensus and are reported as FAIL, they don't stop the run
    downsample_reads = 1500
    seed             = 42
    min_reads        = 40

    // purity check: cluster the reads (vsearch) and build the consensus from
    // the dominant cluster only. cluster_id is deliberately loose -- it only
    // has to tolerate raw ONT error between two reads of the SAME sequence
    enable_purity_check = true
    cluster_id          = 0.70

    // a second consensus: when the next-largest cluster holds at least
    // min_secondary_frac of the reads (and min_reads of them), it is built into
    // a consensus of its own. Its outputs go under "<sample><secondary_suffix>/"
    // and in final_report/secondary_consensus.*; the suffix is fixed (the results
    // viewer keys on it), not something to set. Needs the purity check.
    enable_secondary_consensus = true
    min_secondary_frac         = 0.2
    secondary_suffix           = '.secondary'

    // consensus: spoa draft -> racon -> (medaka). medaka_model has to match the
    // basecaller that produced the reads
    enable_medaka = true
    medaka_model  = 'r1041_e82_400bps_hac_v5.0.0'

    // QC thresholds (defaults follow wf-amplicon's 30X depth / 70% primary)
    min_depth         = 30
    min_primary_frac  = 0.7
    min_dominant_frac = 0.8   // WARN below this share of reads in the dominant cluster
}

// default per-label resources; declared BEFORE `profiles` so profile-level
// overrides (e.g. google_batch) take precedence instead of being clobbered
process {
    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '8.GB'
        time   = '4.h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '16.GB'
        time   = '8.h'
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled  = false
        docker.runOptions = '--platform linux/amd64'
    }
    conda {
        conda.enabled  = true
        docker.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        // set process.queue / clusterOptions per institution HPC as needed
    }
    test {
        includeConfig 'conf/test.config'
    }
    google_batch {
        google.project        = 'iscc-400300'
        google.location       = 'us-central1'
        google.batch.spot     = true
        // pinned explicitly: Batch re-runs a Spot-preempted task up to this many
        // times itself, and Nextflow >= 24.10 changed the default to 0
        google.batch.maxSpotAttempts = 5

        params.container_registry = 'us-central1-docker.pkg.dev/iscc-400300/containers'
        params.dockerhub_registry = 'us-central1-docker.pkg.dev/iscc-400300/containers'

        workDir               = 'gs://nextflow-jobs/single-amplicon/work'
        params.outdir         = 'gs://nextflow-jobs/single-amplicon/results'

        docker.enabled        = true

        // everything process-scoped lives in this ONE block: mixing dotted
        // `process.x = ...` assignments with a nested `process { }` block in
        // the same profile makes the block replace the dotted settings
        process {
            executor      = 'google-batch'
            // retry only when Batch never gave a usable exit code (failed image
            // pull, lost VM, time limit) or reported a Batch-level code (>= 50000,
            // e.g. Spot preemption); a script that really exited 1-255 is
            // deterministic, so retrying would only repeat it
            errorStrategy = {
                (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus >= 50000)
                    ? 'retry' : 'terminate'
            }
            maxRetries    = 3
            container     = { "${params.dockerhub_registry}/library/ubuntu:22.04" }

            withLabel: process_low {
                cpus   = 4
                memory = { 8.GB  * task.attempt }
                time   = { 2.h   * task.attempt }
            }
            withLabel: process_medium {
                cpus   = 8
                memory = { 16.GB * task.attempt }
                time   = { 8.h   * task.attempt }
            }
            withLabel: process_high {
                cpus   = 16
                memory = { 32.GB * task.attempt }
                time   = { 16.h  * task.attempt }
            }
        }
    }
}

timeline {
    enabled = true
    file    = "${params.tracedir}/timeline.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/report.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/trace.txt"
}
